{
  "$id": "menu-schema",
  "type": "object",
  "title": "MenuSchema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Menu schema definition",
  "$defs": {
    "MenuItem": {
      "title": "MenuItem",
      "type": "object",
      "required": ["type", "x-component", "x-component-props"],
      "properties": {
        "type": {
          "const": "object"
        },
        "x-component": {
          "const": "MenuItem"
        },
        "x-ui": {
          "type": "object",
          "properties": {
            "order": {
              "type": "integer",
              "description": "Order of the item (lower values appear first)"
            },
            "visible": {
              "type": "string",
              "description": "Expression to determine if the item should be visible"
            }
          },
          "additionalProperties": false
        },
        "x-component-props": {
          "type": "object",
          "required": ["label"],
          "properties": {
            "label": {
              "type": "string",
              "description": "Display label for the menu item"
            },
            "href": {
              "type": "string",
              "description": "Optional URL the item links to"
            },
            "icon": {
              "type": "string",
              "description": "Optional icon identifier"
            },
            "disabled": {
              "type": "boolean",
              "description": "Disable the menu item"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "MenuGroup": {
      "title": "MenuGroup",
      "type": "object",
      "required": ["type", "x-component", "x-component-props", "properties"],
      "properties": {
        "type": {
          "const": "object"
        },
        "x-component": {
          "const": "MenuGroup"
        },
        "x-ui": {
          "type": "object",
          "properties": {
            "order": {
              "type": "integer"
            },
            "visible": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "x-component-props": {
          "type": "object",
          "required": ["label"],
          "properties": {
            "label": {
              "type": "string",
              "description": "Group label"
            }
          },
          "additionalProperties": true
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-zA-Z_][a-zA-Z0-9_]*$": {
              "$ref": "#/$defs/MenuItem"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["type", "x-component", "properties"],
  "properties": {
    "type": {
      "const": "object"
    },
    "x-component": {
      "const": "MenuContainer"
    },
    "x-component-props": {
      "type": "object",
      "properties": {
        "ariaLabel": {
          "type": "string",
          "description": "Accessible label for the menu"
        }
      },
      "additionalProperties": true
    },
    "properties": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "oneOf": [
            { "$ref": "#/$defs/MenuItem" },
            { "$ref": "#/$defs/MenuGroup" }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
